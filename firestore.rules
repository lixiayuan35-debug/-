rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMediaItem(data) {
      return data.keys().hasAll(['id', 'key', 'data', 'mediaType', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.key is string && data.key.size() > 0 && data.key.size() <= 128
        && data.data is string && data.data.size() > 0
        && data.mediaType is string && (data.mediaType == 'image' || data.mediaType == 'video')
        && data.updatedAt is number;
    }

    function isValidState(data) {
      return data.keys().hasAll(['id', 'lastSyncedAt'])
        && data.id is string && data.id.size() <= 64
        && data.lastSyncedAt is number;
    }

    match /portfolio_media/{mediaId} {
      // Public read so GitHub Pages and any visitors can view all media
      allow read: if true;
      // Allow syncing media items
      allow create, update: if isValidId(mediaId) && isValidMediaItem(request.resource.data);
      allow delete: if isValidId(mediaId);
    }

    match /portfolio_state/{stateId} {
      allow read: if true;
      allow create, update: if isValidId(stateId) && isValidState(request.resource.data);
      allow delete: if isValidId(stateId);
    }
  }
}
